import random
import math

# =============================================================================
#  Раздел 1. Реализация хеш-функций
# =============================================================================

def division_hash(k, m):
    """Метод деления: h(k) = k mod m."""
    return k % m


class UniversalHash:
    """Функция из универсального семейства H(p, m).
    h_ab(k) = ((a*k + b) mod p) mod m, где p - простое, p > u, a != 0.
    """
    DEFAULT_P = 2 ** 31 - 1  # Простое число Мерсенна

    def __init__(self, m, p=None, a=None, b=None, rng=None):
        rng = rng or random
        self.m = m
        self.p = p if p is not None else self.DEFAULT_P
        # a != 0 обязательно, иначе функция станет константой
        self.a = a if a is not None else rng.randrange(1, self.p)
        self.b = b if b is not None else rng.randrange(0, self.p)

    def __call__(self, k):
        return ((self.a * k + self.b) % self.p) % self.m

    def __repr__(self):
        return f"h_ab(m={self.m}, a={self.a}, b={self.b})"


# =============================================================================
#  Раздел 2. Вспомогательные функции для измерений
# =============================================================================

def get_hash_stats(keys, hash_func, m):
    """Возвращает статистику распределения ключей по индексам."""
    loads = [0] * m
    for k in keys:
        loads[hash_func(k)] += 1
    
    n = len(keys)
    occupied = sum(1 for c in loads if c > 0)
    empty = m - occupied
    max_len = max(loads) if loads else 0
    mean_len = n / m if m > 0 else 0.0
    
    return {
        "mean": mean_len,
        "max": max_len,
        "empty": empty
    }


def estimate_collision_probability(k1, k2, m, trials, seed=None):
    """Эмпирическая оценка Pr{h(k1) = h(k2)} по случайным h из семейства."""
    rng = random.Random(seed)
    hits = 0
    for _ in range(trials):
        h = UniversalHash(m, rng=rng)
        if h(k1) == h(k2):
            hits += 1
    return hits / trials



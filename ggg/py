    c = 7
    keys_offset = [c + i * m for i in range(n)]         # Вида c + i*m
    
    key_sets = {
        "Случайные ключи": keys_random,
        f"Ключи, кратные m ({m})": keys_multiples,
        f"Ключи вида c + i*m (c={c})": keys_offset
    }
    
    print(f"{'Набор ключей':<35} | {'Функция':<25} | {'Среднее':<8} | {'Максимум':<9} | {'Пустых':<6}")
    print("-" * 95)
    
    for name, keys in key_sets.items():
        # Статистика для division_hash
        stats_div = get_hash_stats(keys, lambda k: division_hash(k, m), m)
        print(f"{name:<35} | {'division_hash':<25} | {stats_div['mean']:<8.2f} | {stats_div['max']:<9} | {stats_div['empty']:<6}")
        
        # Статистика для UniversalHash
        h_univ = UniversalHash(m, rng=random.Random(2024))
        stats_univ = get_hash_stats(keys, h_univ, m)
        print(f"{name:<35} | {str(h_univ):<25} | {stats_univ['mean']:<8.2f} | {stats_univ['max']:<9} | {stats_univ['empty']:<6}")
        
    print()
    print("КОММЕНТАРИЙ: Почему средняя длина во всех шести случаях одинакова?")
    print("Средняя длина цепочки математически равна n / m (общее число ключей,")
    print("делённое на число ячеек). Поскольку во всех шести экспериментах n = 128")
    print("и m = 32 строго фиксированы, среднее значение всегда равно 128 / 32 = 4.0.")
    print("Средняя длина зависит только от этих двух параметров, но не от качества")
    print("хеш-функции или распределения ключей. Именно поэтому для оценки качества")
    print("хеширования необходимо смотреть на максимальную длину цепочки и число")
    print("пустых ячеек, а не на среднее (как видно из таблицы, максимум у division_hash")
    print("на 'плохих' данных равен 128, что означает полную деградацию в список).")
    print()

    print("=" * 80)
    print("ЗАДАНИЕ 2. Проверка универсальности")
    print("=" * 80)
    
    trials = 10000
    m_test = 32
    
    # 5 пар ключей, включая пару, отличающуюся ровно на m
    key_pairs = [
        (10, 25),
        (1000, 5000),
        (100, 100 + m_test),       # Отличаются ровно на m
        (999999, 1),
        (42, 42 + 2 * m_test)
    ]
    
    print(f"Эмпирическая оценка Pr{{h(k1) = h(k2)}} при {trials} испытаниях (m={m_test}, 1/m = {1/m_test:.5f}):")
    print(f"{'k1':<10} | {'k2':<10} | {'Оценка Pr':<12} | {'1/m':<10} | {'Условие <= 1/m'}")

        diff_note = " (отличаются на m)" if k2 - k1 == m_test else ""
        print(f"{k1:<10} | {k2:<10} | {pr:<12.5f} | {1/m_test:<10.5f} | {condition_met}{diff_note}")
        
    print()
    print("ДЕМОНСТРАЦИЯ ВЫРОЖДЕНИЯ ПРИ a = 0:")
    h_degenerate = UniversalHash(m=16, a=0, b=7)
    test_keys = [0, 1, 2, 3, 100, 999]
    hashes = [h_degenerate(k) for k in test_keys]
